# ===========================================
# SagaTree host-first environment (CUT-22)
# FE-HOST-09 host-first: VITE_SAGATREE_HOST_AUTH_URL is the sole FE routing signal.
# ===========================================
# Product runtime is the Node host (SQLite + Better Auth + assets).
# Copy this file OR prefer the Compose-specific example:
#   cp deployment/.env.host.example deployment/.env.host
#
# Solo/local without Docker:
#   export SAGATREE_DATA_DIR=./.sagatree-data
#   export SAGATREE_BETTER_AUTH_SECRET="$(openssl rand -base64 48)"
#   npm run host:dev   # → server/src/bootstrap/main.ts (server package start)
#
# Docker / VPS:
#   docker compose --env-file deployment/.env.host up -d --build
#   → http://127.0.0.1:8787/health
# Prefer deployment/.env.host.example for Compose (includes SAGATREE_BACKUP_MOUNT).
#
# Optional AI/LiveKit/Meshy: set keys in deployment/.env.host (never bake into images).
# Archived Supabase env template: archive/supabase-legacy/.env.supabase.example

SAGATREE_HOST=127.0.0.1
SAGATREE_PORT=8787
SAGATREE_DATA_DIR=./.sagatree-data
SAGATREE_HOST_MODE=solo
# openssl rand -base64 48
SAGATREE_BETTER_AUTH_SECRET=
# Optional backup bind for Compose (also in deployment/.env.host.example)
# SAGATREE_BACKUP_MOUNT=./backups

# Frontend → host auth origin (Vite).
# With `npm run dev` (Vite :3004 + /api proxy) use same-origin so SameSite cookies work.
# Direct host URL is for FE served from the host origin or matching hostname.
VITE_SAGATREE_HOST_AUTH_URL=same-origin

# Optional providers (empty = core host stays usable)
# CREDENTIALS_ENCRYPTION_KEY=   # 64 hex or 32-byte base64 — required to store user AI keys
# AI_PROVIDER_ALLOW_HOST_KEYS=1 # local/CI only — never enable on public VPS
# CHARACTER_AI_API_KEY=
# MESHY_API_KEY=
# LIVEKIT_URL=
# LIVEKIT_API_KEY=
# LIVEKIT_API_SECRET=
