# ===========================================
# SagaTree Self-Host Configuration
# Copy this file to .env and fill in values
# ===========================================

# Generate with: openssl rand -hex 32
JWT_SECRET=your-jwt-secret-change-me-in-production
# Realtime API JWT (keep equal to JWT_SECRET locally)
API_JWT_SECRET=your-jwt-secret-change-me-in-production

# PostgreSQL Password
POSTGRES_PASSWORD=your-super-secret-password-change-me

# Kong workers (#605) — default 1; set 2 then: docker compose up -d --force-recreate supabase-kong
# KONG_NGINX_WORKER_PROCESSES=1
# Edge JWT gate (#605) — default true; local opt-out only:
# VERIFY_JWT=false
# Auth abuse ceilings (#670) — Kong also rate-limits /auth/v1 (30/min/IP); see docs/ops/auth-ai-gm-rate-limits.md
# GOTRUE_RATE_LIMIT_EMAIL_SENT=10
# AI_GM_RATE_LIMIT=12
# Local Admin shortcut (admin/1234) + migrations 011/074 are DEV-only — never expose on internet-facing hosts.

# Realtime (Phoenix) — required for sagatree-realtime to boot (#604)
# Generate: openssl rand -base64 64
SECRET_KEY_BASE=replace-with-openssl-rand-base64-64
# 16 hex chars: openssl rand -hex 8
DB_ENC_KEY=0123456789abcdef
FLY_APP_NAME=sagatree
FLY_REGION=us-east-1
REALTIME_SEED_SELF_HOST=true
# Must match browser Host (local Kong → localhost)
REALTIME_SELF_HOST_TENANT=localhost

# Generate with: openssl rand -base64 32
SUPABASE_ANON_KEY=your-anon-key-change-me
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-change-me

# Frontend Supabase connection. VITE_SUPABASE_ANON_KEY must match SUPABASE_ANON_KEY above.
# Configure both VITE values together so the browser uses the self-hosted gateway.
VITE_SUPABASE_URL=http://localhost:8000
VITE_SUPABASE_ANON_KEY=your-anon-key-change-me
# Required in all builds (#672) — no committed hosted JWT fallback.
# Optional Figma Make DevTrack (DEV only; omit to disable):
# VITE_DEVTRACK_SNIPPET_KEY=
# VITE_DEVTRACK_API_URL=
# VITE_DEVTRACK_AUTH_KEY=

# Site URL
SITE_URL=http://localhost:3000
ADDITIONAL_REDIRECT_URLS=http://localhost:3000/auth/callback

# SMTP (optional, for email)
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=your-email@example.com
# SMTP_PASS=your-email-password
# SMTP_ADMIN_EMAIL=admin@example.com

# Email confirmation (set to false for production)
MAILER_AUTOCONFIRM=true
DISABLE_SIGNUP=false

# Compose profiles (docs/ops/compose-profiles.md)
# Default `docker compose up -d` = core only (good for ~8 GB VPS / cloud LLM).
# Optional: --profile ai-local | graph | dev-tools | full
# NEO4J_HEAP_INITIAL=256m
# NEO4J_HEAP_MAX=512m
# NEO4J_MEM_LIMIT=768m
# OLLAMA_MEM_LIMIT=4g

# Neo4j Password (only needed with --profile graph|full)
NEO4J_PASSWORD=your-neo4j-password-change-me

# --- AI: prefer cloud/remote on small VPS (do not enable ai-local) ---
# Used by ai-gm + character-lore + session-recap (Env fallback).
# Per-user override: Settings → AI → Organize (Edge ollama-settings →
# user_ai_provider_credentials provider_id=ollama). Requires CREDENTIALS_ENCRYPTION_KEY.
# OpenAI-compatible example:
# CHARACTER_AI_PROVIDER=openai-compatible
# CHARACTER_AI_BASE_URL=https://your-provider.example/v1
# CHARACTER_AI_API_KEY=
# CHARACTER_AI_MODEL=your-model

# Local Ollama (requires: docker compose --profile ai-local up -d)
OLLAMA_MODEL=llama3.2
# OLLAMA_HOST=http://ollama:11434

# Character / GM AI provider
# Supported providers: ollama | openai-compatible
CHARACTER_AI_PROVIDER=ollama
# Optional: falls back to OLLAMA_MODEL when omitted
# CHARACTER_AI_MODEL=llama3.2
# Optional for Ollama: falls back to OLLAMA_HOST and then http://ollama:11434
# Required for openai-compatible providers / Ollama Cloud
# CHARACTER_AI_BASE_URL=http://ollama:11434
# CHARACTER_AI_BASE_URL=https://ollama.com/v1
# Required only for openai-compatible / cloud. Keep the real value in server secrets.
# CHARACTER_AI_API_KEY=
# Enforced persistently across Edge Runtime instances by migration 003 + service-role RPC.
CHARACTER_AI_RATE_LIMIT_PER_MINUTE=6
# CORS for character-lore Edge Function (fail-closed, never defaults to *):
# - Leave unset for local Vite only (localhost / 127.0.0.1)
# - Production: set exact origin(s), comma-separated
# - Explicit "*" only when intentionally allowing any origin
CHARACTER_AI_ALLOWED_ORIGIN=http://localhost:3004

# Item thumbnails + optional Meshy text-to-image / Image-to-3D (Edge Function secrets only — never VITE_/NEXT_PUBLIC_)
# Prod: user BYOK via Settings → AI (ai-provider-credentials). Host MESHY_API_KEY only when allowed:
# AI_PROVIDER_ALLOW_HOST_KEYS=1
# CREDENTIALS_ENCRYPTION_KEY=   # 64 hex chars or 32-byte base64 — required to store user keys
# MESHY_API_KEY=
# Optional MIG-301 host AI adapters (requires host auth URL + explicit opt-in; Edge remains default):
# VITE_SAGATREE_HOST_AUTH_URL=http://127.0.0.1:8787
# VITE_SAGATREE_HOST_AI=1
# MESHY_API_BASE_URL=https://api.meshy.ai/openapi/v1
# MESHY_TEXT_TO_IMAGE_MODEL=nano-banana
# MESHY_IMAGE_TO_3D_MODEL=latest
# AI_PROVIDER_CREDENTIAL_RATE_LIMIT_PER_MINUTE=8
ITEM_THUMBNAIL_RATE_LIMIT_PER_MINUTE=4
ITEM_THUMBNAIL_ALLOWED_ORIGIN=http://localhost:3004
# ITEM_THUMBNAIL_MESHY_MOCK=1
ITEM_MODEL3D_RATE_LIMIT_PER_MINUTE=2
ITEM_MODEL3D_ALLOWED_ORIGIN=http://localhost:3004
# ITEM_MODEL3D_MESHY_MOCK=1
# AI_PROVIDER_ALLOWED_ORIGIN=http://localhost:3004
# AI_PROVIDER_ALLOW_HOST_KEYS=1
# CREDENTIALS_ENCRYPTION_KEY=
