    },
    {
      "id": "target-concurrency-capacity-decision",
      "status": "NOT RUN",
      "reason": "20×50 local workload passed when R7 is PASS, but target state sizes, throughput/latency SLO, hardware, long-running contention and session mix are unspecified. Human GATE review must decide sufficiency."
    },
    {
      "id": "power-loss-durability",
      "status": "NOT RUN",
      "reason": "SIGKILL proves process-crash recovery; no kernel, host-power, disk-full, fsync-failure or faulty-storage simulation."
    },
    {
      "id": "production-auth-and-realtime",
      "status": "NOT RUN",
      "reason": "Server-owned fixture tokens/memberships and IPC notifications exercise the boundary; OIDC, service policy parity, sockets, backpressure, event retention and an atomic subscribe/catch-up protocol are separate gates."
    },
    {
      "id": "platform-matrix",
      "status": "NOT RUN",
      "reason": "Evidence records the exact executed host/runtime. Other OS, filesystem and Node versions require their own execution; Node 22.13 API compatibility is documentation-checked only."
    }
