# SagaTree host Compose — copy to deployment/.env.host (never commit secrets).
# docker compose --env-file deployment/.env.host -f deployment/docker-compose.host.yml up -d

# Publish bind (loopback default). Auth default is flat http://127.0.0.1:8787
# (never derived from publish — a 0.0.0.0 bind must not become a trusted origin).
SAGATREE_HOST_PUBLISH=127.0.0.1:8787

# Required for container remote bind (GATE-02 cookie profile)
# openssl rand -base64 48
SAGATREE_BETTER_AUTH_SECRET=
# Optional override — leave unset so Compose defaults to http://127.0.0.1:8787.
# Set explicitly when changing publish port or for LAN cookie origins (else HOST_DENIED).
# SAGATREE_AUTH_BASE_URL=http://127.0.0.1:8787
# SAGATREE_AUTH_TRUSTED_ORIGINS=http://127.0.0.1:3004

# Optional backup bind mount (host path → /backups in container)
SAGATREE_BACKUP_MOUNT=./backups

# Profile flags (set to 1 when starting with --profile ai / --profile media)
SAGATREE_COMPOSE_PROFILE_AI=0
SAGATREE_COMPOSE_PROFILE_MEDIA=0

# Optional AI — inject externally; leave empty for host-only core
# CREDENTIALS_ENCRYPTION_KEY=
# CHARACTER_AI_PROVIDER=openai-compatible
# CHARACTER_AI_BASE_URL=
# CHARACTER_AI_API_KEY=
# CHARACTER_AI_MODEL=
# OLLAMA_HOST=http://ollama:11434
# MESHY_API_KEY=

# Optional media external keys (empty → explained capability / unsupported status)
