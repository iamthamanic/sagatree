# SagaTree Node host image (MIG-601 / #846)
# Host-only runtime: Node 22 + SQLite data dir. No cloud secrets baked in.
FROM node:22-bookworm-slim

WORKDIR /app

# Install host package only (server/ is the registered host package).
COPY server/package.json server/package-lock.json ./server/
RUN cd server && npm ci --omit=dev

COPY server/migrations ./server/migrations
COPY server/src ./server/src

# Bind defaults for containers; secrets / auth base URL come from Compose env at runtime.
ENV NODE_ENV=production \
    SAGATREE_HOST=0.0.0.0 \
    SAGATREE_PORT=8787 \
    SAGATREE_DATA_DIR=/data \
    SAGATREE_ALLOW_REMOTE_BIND=1 \
    SAGATREE_HOST_MODE=remote

WORKDIR /app/server
EXPOSE 8787

# Health becomes green only after createHost start (SQLite bootstrap) succeeds.
CMD ["node", "--experimental-strip-types", "src/bootstrap/main.ts"]
